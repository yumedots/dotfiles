#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
	echo "run as root: sudo $0" >&2
	exit 1
fi

src=$(cd "$(dirname "$0")/.." && pwd)
target=${1:-$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }')}

if [ -z "$target" ]; then
	echo "no login user found" >&2
	exit 1
fi

home=$(getent passwd "$target" | cut -d: -f6)
wall=""

if [ -r "$home/.config/quickshell/cache/settings.lua" ]; then
	wall=$(sed -n 's/^[[:space:]]*wallpaper[[:space:]]*=[[:space:]]*"\(.*\)",\{0,1\}[[:space:]]*$/\1/p' "$home/.config/quickshell/cache/settings.lua" | head -1)
fi

install -d -m 755 /etc/greetd
chmod 755 /etc/greetd
rm -rf /etc/greetd/quickshell
rm -f /etc/greetd/hyprland.lua /etc/greetd/start-greeter

chmod o+x "$home"

if ! runuser -u greeter -- test -r "$home/.config/quickshell/greeterShell.qml"; then
	echo "greeter cannot read the shell in $home/.config/quickshell" >&2
	exit 1
fi

install -d -m 755 /var/lib/quickshell
install -d -o root -g "$target" -m 775 /var/lib/quickshell/greeter

wallpaper=""

if [ -n "$wall" ] && [ -r "$wall" ]; then
	install -m 644 "$wall" /var/lib/quickshell/greeter/wallpaper
	wallpaper="/var/lib/quickshell/greeter/wallpaper"
fi


printf 'd /run/greeter 0700 greeter greeter -\n' > /etc/tmpfiles.d/greetd-greeter.conf
systemd-tmpfiles --create /etc/tmpfiles.d/greetd-greeter.conf

install -d -o greeter -g greeter -m 700 /var/lib/greetd
install -d -o greeter -g greeter -m 700 /var/lib/greetd/cache
install -d -o greeter -g greeter -m 700 /var/lib/greetd/state

usermod -aG video,render,input greeter

power_tmp=$(mktemp)
printf 'greeter ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff, /usr/bin/systemctl reboot, /usr/bin/systemctl suspend\n' >"$power_tmp"
visudo -cf "$power_tmp" >/dev/null
install -m 440 "$power_tmp" /etc/sudoers.d/greeter-power
rm -f "$power_tmp"

rm -f /usr/local/bin/qs-logout
rm -f /etc/sudoers.d/greeter-logout

install -d -m 755 /etc/polkit-1/rules.d

cat > /etc/polkit-1/rules.d/49-quickshell-greeter.rules <<POLKIT
polkit.addRule(function (action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
		subject.user == "$target" &&
		action.lookup("unit") == "greetd.service" &&
		action.lookup("verb") == "start") {
		return polkit.Result.YES;
	}
});
POLKIT

chmod 644 /etc/polkit-1/rules.d/49-quickshell-greeter.rules

[ -f /etc/security/faillock.conf.bak ] || cp -a /etc/security/faillock.conf /etc/security/faillock.conf.bak

cat > /etc/security/faillock.conf <<'FAILLOCK'
deny = 3
unlock_time = 3
FAILLOCK

[ -f /etc/greetd/config.toml.bak ] || cp -a /etc/greetd/config.toml /etc/greetd/config.toml.bak

cat > /etc/greetd/config.toml <<CFG
[terminal]
vt = 1

[default_session]
command = "$home/.config/quickshell/greeter/start-greeter"
user = "greeter"
CFG

faillock --user "$target" --reset >/dev/null 2>&1 || true

systemctl disable sddm >/dev/null 2>&1 || true
systemctl enable greetd >/dev/null

echo "greeter installed for $target"
echo "wallpaper: ${wallpaper:-none}"
echo "sddm is disabled for the next boot, greetd is enabled."
echo "your current session is untouched; reboot to test."
echo "rollback: sudo $(dirname "$0")/greeter-uninstall"
