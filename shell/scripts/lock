#!/bin/sh
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
shell="$dir/../lockShell.qml"
pidfile="${XDG_RUNTIME_DIR:-/tmp}/qs-lock.pid"

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

alive() {
	[ -r "$pidfile" ] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null
}

live_signature() {
	if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -S "$runtime/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" ]; then
		return
	fi

	for socket in "$runtime"/hypr/*/.socket2.sock; do
		[ -S "$socket" ] || continue
		socket="${socket%/.socket2.sock}"
		HYPRLAND_INSTANCE_SIGNATURE="${socket##*/}"
		export HYPRLAND_INSTANCE_SIGNATURE
		return
	done
}

live_display() {
	if [ -S "$runtime/${WAYLAND_DISPLAY:-none}" ]; then
		return
	fi

	for socket in "$runtime"/wayland-*; do
		case "${socket##*/}" in
			wayland-[0-9] | wayland-[0-9][0-9]) ;;
			*) continue ;;
		esac

		[ -S "$socket" ] || continue
		WAYLAND_DISPLAY="${socket##*/}"
		export WAYLAND_DISPLAY
		return
	done
}

ipc_lock() {
	qs -p "$dir/../shell.qml" ipc call shell lockState "$1" >/dev/null 2>&1 || true
}

launch() {
	live_display
	live_signature
	ulimit -Sn 65536 2>/dev/null || true
	export MALLOC_ARENA_MAX=2 MALLOC_TRIM_THRESHOLD_=65536 QSG_RENDER_LOOP=basic
	setsid quickshell -p "$shell" >/dev/null 2>&1 &
	pid=$!
	echo "$pid" >"$pidfile"
	ipc_lock true &
	hyprctl dispatch 'hl.dsp.submap("lock")' >/dev/null 2>&1 || true
	(
		while kill -0 "$pid" 2>/dev/null; do sleep 0.4; done
		hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1 || true
		ipc_lock false
	) >/dev/null 2>&1 &
}

case "${1:-lock}" in
	preview)
		alive && exit 0
		QS_LOCK_PREVIEW=1 launch
		;;
	*)
		alive && exit 0
		launch
		;;
esac
