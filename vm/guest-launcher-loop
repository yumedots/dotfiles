#!/bin/sh
set -eu

export XDG_RUNTIME_DIR=/run/user/1000
export WAYLAND_DISPLAY=wayland-1
export HYPRLAND_INSTANCE_SIGNATURE=$(ls /run/user/1000/hypr | head -1)

i=0
while [ "$i" -lt 20 ]; do
	hyprctl dispatch 'hl.dsp.global("quickshell:launcher")' >/dev/null 2>&1 || true
	sleep 0.5
	i=$((i + 1))
done
