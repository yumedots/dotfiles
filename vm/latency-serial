#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
VM=${1:-demo}
N=${2:-20}
Y=$ROOT/scripts/yudae
OUT=$ROOT/vm/runs/$VM/latency-serial
SERIAL=$ROOT/vm/runs/$VM/serial.log
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/1000}
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-1}
export HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-$(ls "$XDG_RUNTIME_DIR"/hypr | head -1)}

mkdir -p "$OUT"

guest() {
	"$Y" vm exec "$VM" "$1" >/dev/null 2>&1
}

hypr() {
	hyprctl dispatch "$1" >/dev/null
}

guest "sh $ROOT/vm/guest-marker"
sleep 1

stdbuf -oL tail -n 0 -F "$SERIAL" | while IFS= read -r line; do
	case "$line" in
		YUDAE_K* | YUDAE_M*) printf '%s %s\n' "$(date +%s.%N)" "$line" ;;
	esac
done >"$OUT/markers.txt" &
TAIL_PID=$!

hypr 'function() for _,w in ipairs(hl.get_windows()) do if w.class == "com.yudae.vms" then hl.dispatch(hl.dsp.focus({window=w})); return end end end'
hypr 'hl.dsp.cursor.move({x=900,y=400})'
sleep 0.3
YDOTOOL_SOCKET=$XDG_RUNTIME_DIR/.ydotool_socket ydotool click 0xC0
sleep 0.3

: >"$OUT/keys-times.txt"
for _ in $(seq 1 "$N"); do
	date +%s.%N >>"$OUT/keys-times.txt"
	YDOTOOL_SOCKET=$XDG_RUNTIME_DIR/.ydotool_socket ydotool key 30:1 30:0
	sleep 0.2
done

: >"$OUT/mouse-times.txt"
for _ in $(seq 1 "$N"); do
	date +%s.%N >>"$OUT/mouse-times.txt"
	YDOTOOL_SOCKET=$XDG_RUNTIME_DIR/.ydotool_socket ydotool mousemove -x 15 -y 8
	sleep 0.2
done

sleep 1
kill "$TAIL_PID" 2>/dev/null || true
wait "$TAIL_PID" 2>/dev/null || true
guest "sh $ROOT/vm/guest-marker-stop"

python3 - "$OUT" <<'PY'
import statistics
import sys
from pathlib import Path

out = Path(sys.argv[1])
keys_host = [float(x) for x in (out / "keys-times.txt").read_text().split()]
mouse_host = [float(x) for x in (out / "mouse-times.txt").read_text().split()]
markers = []
for line in (out / "markers.txt").read_text().splitlines():
    parts = line.split()
    if len(parts) < 2:
        continue
    markers.append((float(parts[0]), "K" if "YUDAE_K" in parts[1] else "M"))

def report(name, kind, host):
    times = [t for t, k in markers if k == kind]
    n = min(len(times), len(host))
    lat = sorted((times[i] - host[i]) * 1000 for i in range(n))
    if not lat:
        print(f"{name}: no samples")
        return
    p50 = statistics.median(lat)
    p95 = lat[min(len(lat) - 1, int(len(lat) * 0.95))]
    print(f"{name}: n={n} p50={p50:.2f}ms p95={p95:.2f}ms min={lat[0]:.2f}ms max={lat[-1]:.2f}ms")
    (out / f"{name}.txt").write_text("\n".join(f"{v:.3f}" for v in lat) + "\n")

report("key", "K", keys_host)
report("mouse", "M", mouse_host)
PY
