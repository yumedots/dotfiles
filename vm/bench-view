#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
VM=${1:-demo}
SECS=${BENCH_SECS:-10}
Y=$ROOT/scripts/yudae
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/1000}
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-1}
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
	for dir in $(ls -t "$XDG_RUNTIME_DIR"/hypr 2>/dev/null); do
		[ -S "$XDG_RUNTIME_DIR/hypr/$dir/.socket.sock" ] && export HYPRLAND_INSTANCE_SIGNATURE=$dir && break
	done
fi

hypr() {
	hyprctl dispatch "$1" >/dev/null
}

guest() {
	"$Y" vm exec "$VM" "$1" >/dev/null 2>&1
}

viewer_full() {
	hypr 'function() for _,w in ipairs(hl.get_windows()) do if w.class == "com.yudae.vms" then hl.dispatch(hl.dsp.focus({window=w})); if (w.fullscreen or 0) == 0 then hl.dispatch(hl.dsp.window.fullscreen()) end return end end end'
	sleep 1
}

viewer_unfull() {
	hypr 'function() for _,w in ipairs(hl.get_windows()) do if w.class == "com.yudae.vms" then if (w.fullscreen or 0) ~= 0 then hl.dispatch(hl.dsp.window.fullscreen()) end return end end end'
	sleep 1
}

ticks() {
	awk '{print $14 + $15}' "/proc/$1/stat" 2>/dev/null || echo 0
}

rss() {
	awk '/VmRSS/ {print $2}' "/proc/$1/status" 2>/dev/null || echo 0
}

pids() {
	QPID=$(pgrep -f "^/home/gabriel/qemu-linux/install/bin/qemu-system-x86_64 -name yudae-$VM" | head -1)
	VPID=$(pgrep -f "^quickshell -p /home/gabriel/dotfiles/shell/app-vms.qml" | head -1)
	HPID=$(pgrep -x Hyprland | head -1)
}

run_scenario() {
	case "$1" in
		S0) ;;
		S1)
			guest "setsid sh $ROOT/vm/guest-launcher-loop >/dev/null 2>&1 &"
			;;
		S2)
			guest "sh $ROOT/vm/guest-anim"
			;;
	esac
}

stop_scenario() {
	case "$1" in
		S0) ;;
		S1)
			guest "sh $ROOT/vm/guest-key Escape"
			;;
		S2)
			guest "sh $ROOT/vm/guest-anim-close"
			;;
	esac
}

measure() {
	local config=$1
	local scenario=$2
	pids
	local q0 v0 h0
	q0=$(ticks "$QPID")
	v0=$(ticks "$VPID")
	h0=$(ticks "$HPID")
	run_scenario "$scenario"
	sleep 1
	( for _ in $(seq 1 "$SECS"); do nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null; sleep 1; done ) >"$ROOT/vm/runs/$VM/gpu-$config-$scenario.txt" &
	local gpid=$!
	sleep "$SECS"
	stop_scenario "$scenario"
	wait "$gpid" 2>/dev/null || true
	local q1 v1 h1
	q1=$(ticks "$QPID")
	v1=$(ticks "$VPID")
	h1=$(ticks "$HPID")
	local gpu
	gpu=$(awk '$1 ~ /^[0-9.]+$/ {s += $1; n++} END {if (n) printf "%.1f", s / n; else printf "0"}' "$ROOT/vm/runs/$VM/gpu-$config-$scenario.txt")
	printf '%s,%s,%.1f,%.1f,%.1f,%s,%d,%d\n' "$config" "$scenario" \
		"$(awk -v a="$q0" -v b="$q1" -v s="$SECS" 'BEGIN {print (b - a) / 100 / s * 100}')" \
		"$(awk -v a="$v0" -v b="$v1" -v s="$SECS" 'BEGIN {print (b - a) / 100 / s * 100}')" \
		"$(awk -v a="$h0" -v b="$h1" -v s="$SECS" 'BEGIN {print (b - a) / 100 / s * 100}')" \
		"$gpu" "$(rss "$QPID")" "$(rss "$VPID")"
}

pkill -f '[a]pp-vms.qml' 2>/dev/null || true
sleep 1
"$Y" app open vms --vm "$VM" >/dev/null
sleep 3

printf 'config,scenario,qemu_cpu,viewer_cpu,hypr_cpu,gpu,qemu_rss_kb,viewer_rss_kb\n'

viewer_unfull
for scenario in S0 S1 S2; do
	measure windowed "$scenario"
done

viewer_full
for scenario in S0 S1 S2; do
	measure fullscreen "$scenario"
done

viewer_unfull
