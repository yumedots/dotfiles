#!/bin/sh
set -eu

export XDG_RUNTIME_DIR=/run/user/1000
export WAYLAND_DISPLAY=wayland-1
export HYPRLAND_INSTANCE_SIGNATURE=$(ls /run/user/1000/hypr | head -1)

k=$(grep -l 'QEMU Virtio Keyboard' /sys/class/input/event*/device/name | sed 's#/sys/class/input/\(event[0-9]*\)/device/name#/dev/input/\1#' | head -1)
m=$(grep -l 'QEMU Virtio Tablet' /sys/class/input/event*/device/name | sed 's#/sys/class/input/\(event[0-9]*\)/device/name#/dev/input/\1#' | head -1)

if [ -f /tmp/marker.pid ]; then
	sudo -n kill "$(cat /tmp/marker.pid)" 2>/dev/null || true
fi

rm -f /tmp/marker.log
setsid sudo -n python3 /home/gabriel/dotfiles/vm/guest-marker.py "$k" "$m" >/tmp/marker.log 2>&1 &
echo $! >/tmp/marker.pid
sleep 1
