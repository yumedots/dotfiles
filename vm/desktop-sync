#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
BIN=$ROOT/vm/hostbin
WALL=$ROOT/vm/hostwall
STATE=$ROOT/vm/hoststate

mkdir -p "$BIN" "$WALL" "$STATE"

timezone=$(cat /etc/timezone 2>/dev/null || true)
[ -n "$timezone" ] || timezone=$(readlink -f /etc/localtime | sed 's|.*/zoneinfo/||')
printf '%s\n' "$timezone" > "$STATE/timezone"
date +%s > "$STATE/epoch"

for name in awww awww-daemon; do
	[ -x "/usr/bin/$name" ] && cp -f "/usr/bin/$name" "$BIN/$name"
done

native=$ROOT/shell/native/qml/Yudae/Native
if [ -d "$native" ]; then
	mkdir -p "$BIN/yudae-native/Yudae/Native"
	cp -f "$native"/* "$BIN/yudae-native/Yudae/Native/"
fi

settings=$ROOT/shell/cache/settings.lua
wallpaper=$(sed -n 's/^[[:space:]]*wallpaper[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$settings" 2>/dev/null | head -1)
printf '%s\n' "$wallpaper" > "$STATE/wallpaper"
