#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/vm
RUNS=${DOTFILES_VM_RUNS:-$ROOT/vm/runs}

CLOUD_NAME=Arch-Linux-x86_64-cloudimg-20261101.620452.qcow2
CLOUD_SHA=794eb4889b39e1f0ed7d5ae998b2a1ed2137db8cf8c3476cf2962c7437ecb003
CLOUD=$CACHE/$CLOUD_NAME
PACKAGES=$CACHE/packages.qcow2
GOLDEN=$CACHE/golden.qcow2
ARCH_SNAPSHOT=""
FORCE=0
VM_EXCLUDE='^(cachyos-|linux-cachyos|linux-firmware|qemu-|virtiofsd|firefox|qbittorrent|prismlauncher|vlc|tesseract|rust|zig|clang|llvm|cmake|ninja|intel-ucode|amd-ucode|sof-firmware|alsa-firmware|openstarbound|polychromatic|vinegar|visual-studio-code-insiders-bin|wlrctl|libvirt|docker|podman|noto-fonts$|noto-fonts-cjk|awesome-terminal-fonts|cantarell-fonts|ttf-bitstream-vera|ttf-liberation|ttf-opensans|dolphin|nautilus|pavucontrol|bind$|dnsmasq|iwd|modemmanager|usb_modeswitch|xl2tpd|nfs-utils|ufw|layer-shell-qt|graphicsmagick|xdg-desktop-portal-gtk|xdg-desktop-portal-kde|polkit-kde-agent|polkit-gnome)|nvidia'
SEED=$CACHE/seed.img
LOG=$CACHE/provision.log
QEMU=$(command -v qemu-system-x86_64)
QEMU_IMG=$(command -v qemu-img)

mirrors=(
	https://geo.mirror.pkgbuild.com
	https://mirror.rackspace.com/archlinux
	https://mirrors.kernel.org/archlinux
	https://archlinux.mirror.wearetriple.com
	https://mirror.funami.tech/archlinux
)

usage() {
	echo "usage: vm/images fetch|packages [--snapshot YYYY/MM/DD] [--force]|golden [--snapshot YYYY/MM/DD] [--force]|ensure|overlay <name> [golden-tag]|snapshot <name> <tag>|restore <name> <tag>|list" >&2
	exit 2
}

speed_pick() {
	local best="" best_speed=0 mirror speed url
	for mirror in "${mirrors[@]}"; do
		url="$mirror/images/latest/$CLOUD_NAME"
		speed=$(curl -fsSL --max-time 15 -r 0-2097151 -o /dev/null -w '%{speed_download}' "$url" 2>/dev/null || echo 0)
		echo "probe $mirror ${speed%.*}B/s" >&2
		if [ "${speed%.*}" -gt "$best_speed" ]; then
			best_speed=${speed%.*}
			best=$url
		fi
	done
	[ -n "$best" ] || best="https://geo.mirror.pkgbuild.com/images/latest/$CLOUD_NAME"
	echo "$best"
}

cmd_fetch() {
	mkdir -p "$CACHE"
	if [ -f "$CLOUD" ] && [ "$(sha256sum "$CLOUD" | cut -d' ' -f1)" = "$CLOUD_SHA" ]; then
		echo "cloud image cached $CLOUD"
		return
	fi
	local url
	url=$(speed_pick)
	echo "download $url"
	curl -fL --retry 3 --progress-bar -o "$CLOUD.part" "$url"
	echo "$CLOUD_SHA  $CLOUD.part" | sha256sum -c -
	mv "$CLOUD.part" "$CLOUD"
}

provision_script() {
	cat <<'SCRIPT'
#!/bin/bash
set -u
exec > >(tee /dev/console) 2>&1
echo "dotfiles: provision start"
@SNAPSHOT@
sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 12/' /etc/pacman.conf
mkdir -p /mnt/hostpkg
mountpoint -q /mnt/hostpkg || mount -t 9p -o trans=virtio,version=9p2000.L,ro hostpkg /mnt/hostpkg
mkdir -p /var/cache/pacman/pkg
for pkg in /mnt/hostpkg/*.pkg.tar.zst /mnt/hostpkg/*.pkg.tar.xz; do
	[ -e "$pkg" ] || continue
	ln -sf "$pkg" "/var/cache/pacman/pkg/$(basename "$pkg")"
done
rm -f /var/cache/pacman/pkg/limine-* /var/cache/pacman/pkg/plymouth-*
pacman -Sy --noconfirm >/dev/null 2>&1
vm_exclude='@EXCLUDE@'
grep -vE "$vm_exclude" /opt/packages.txt > /tmp/candidates.txt
pacman -Slq | grep -Fxf /tmp/candidates.txt > /tmp/install.txt 2>/dev/null || true
pacman -Syu --needed --noconfirm $(cat /tmp/install.txt) 2>&1 | tee /tmp/pacman.log
if grep -q 'failed to commit transaction' /tmp/pacman.log; then
	grep 'signature from' /tmp/pacman.log | sed 's/^error: //; s/:.*//' | while read -r name; do
		rm -f /var/cache/pacman/pkg/"$name"-*.pkg.tar.*
	done
	pacman -Syu --needed --noconfirm $(cat /tmp/install.txt)
fi
pacman -Scc --noconfirm >/dev/null 2>&1 || true
cp /tmp/install.txt /opt/packages.installed
fstrim -av >/dev/null 2>&1 || true
bash /opt/golden-setup.sh
touch /var/lib/dotfiles-provisioned
echo "dotfiles: provision done"
poweroff
SCRIPT
}

delta_script() {
	cat <<'SCRIPT'
#!/bin/bash
set -u
exec > >(tee /dev/console) 2>&1
echo "dotfiles: delta start"
@SNAPSHOT@
sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 12/' /etc/pacman.conf
mkdir -p /mnt/hostpkg
mountpoint -q /mnt/hostpkg || mount -t 9p -o trans=virtio,version=9p2000.L,ro hostpkg /mnt/hostpkg
mkdir -p /var/cache/pacman/pkg
for pkg in /mnt/hostpkg/*.pkg.tar.zst /mnt/hostpkg/*.pkg.tar.xz; do
	[ -e "$pkg" ] || continue
	ln -sf "$pkg" "/var/cache/pacman/pkg/$(basename "$pkg")"
done
rm -f /var/cache/pacman/pkg/limine-* /var/cache/pacman/pkg/plymouth-*
pacman -Sy --noconfirm >/dev/null 2>&1
vm_exclude='@EXCLUDE@'
grep -vE "$vm_exclude" /opt/packages.txt > /tmp/candidates.txt
pacman -Slq | grep -Fxf /tmp/candidates.txt > /tmp/install.txt 2>/dev/null || true
if [ -f /opt/packages.installed ]; then
	sort -u /opt/packages.installed > /tmp/old.txt
	sort -u /tmp/install.txt > /tmp/new.txt
	comm -23 /tmp/old.txt /tmp/new.txt > /tmp/remove.txt
	if [ -s /tmp/remove.txt ]; then
		pacman -Rns --noconfirm $(cat /tmp/remove.txt) 2>&1 | tee /tmp/pacman-remove.log || pacman -R --noconfirm $(cat /tmp/remove.txt) 2>&1 | tee -a /tmp/pacman-remove.log || true
	fi
fi
pacman -Syu --needed --noconfirm $(cat /tmp/install.txt) 2>&1 | tee /tmp/pacman.log
if grep -q 'failed to commit transaction' /tmp/pacman.log; then
	grep 'signature from' /tmp/pacman.log | sed 's/^error: //; s/:.*//' | while read -r name; do
		rm -f /var/cache/pacman/pkg/"$name"-*.pkg.tar.*
	done
	pacman -Syu --needed --noconfirm $(cat /tmp/install.txt)
fi
orphans=$(pacman -Qtdq)
[ -z "$orphans" ] || pacman -Rns --noconfirm $orphans >/dev/null 2>&1 || true
cp /tmp/install.txt /opt/packages.installed
bash /opt/golden-setup.sh
pacman -Scc --noconfirm >/dev/null 2>&1 || true
fstrim -av >/dev/null 2>&1 || true
echo "dotfiles: delta done"
poweroff
SCRIPT
}

vms_exist() {
	[ -d "$RUNS" ] || return 1
	find "$RUNS" -mindepth 2 -maxdepth 2 -name disk.qcow2 -print -quit 2>/dev/null | grep -q .
}

packages_want() {
	{ cat "$CACHE/seed/packages.txt" 2>/dev/null; printf '%s\n' "$ARCH_SNAPSHOT" "$CLOUD_NAME"; provision_script; delta_script; } | sha256sum | cut -d' ' -f1
}

cmd_packages() {
	mkdir -p "$CACHE/seed"
	local source=${DOTFILES_VM_PACKAGES:-}
	if [ -n "$source" ]; then
		cp "$source" "$CACHE/seed/packages.txt"
	else
		pacman -Qqen > "$CACHE/seed/packages.txt"
	fi

	local stamp=$CACHE/packages.sha current delta=0
	current=$(packages_want)

	if [ "$FORCE" -eq 0 ] && [ -f "$PACKAGES" ] && [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$current" ]; then
		echo "packages layer cached $PACKAGES"
		return
	fi

	if vms_exist; then
		echo "refused: VMs exist under $RUNS; destroy them first (yudae vm list)" >&2
		exit 1
	fi

	cmd_fetch

	if [ -f "$PACKAGES" ] && [ "$FORCE" -eq 0 ]; then
		delta=1
	else
		mkdir -p "$CACHE"
		rm -f "$PACKAGES"
		"$QEMU_IMG" create -f qcow2 -o lazy_refcounts=on -F qcow2 -b "$CLOUD" "$PACKAGES" 32G
	fi

	local snapshot_line=""
	if [ -n "$ARCH_SNAPSHOT" ]; then
		snapshot_line="echo 'Server = https://archive.archlinux.org/repos/${ARCH_SNAPSHOT}/\$repo/os/\$arch' > /etc/pacman.d/mirrorlist"
	fi

	if [ "$delta" -eq 1 ]; then
		delta_script | sed "s|@SNAPSHOT@|$snapshot_line|; s#@EXCLUDE@#$VM_EXCLUDE#" > "$CACHE/seed/provision.sh"
		if "$QEMU_IMG" snapshot -l "$PACKAGES" 2>/dev/null | grep -q delta-backup; then
			"$QEMU_IMG" snapshot -a delta-backup "$PACKAGES" >/dev/null 2>&1 || true
			"$QEMU_IMG" snapshot -d delta-backup "$PACKAGES" >/dev/null 2>&1 || true
		fi
		"$QEMU_IMG" snapshot -c delta-backup "$PACKAGES" >/dev/null
	else
		provision_script | sed "s|@SNAPSHOT@|$snapshot_line|; s#@EXCLUDE@#$VM_EXCLUDE#" > "$CACHE/seed/provision.sh"
	fi

	packages_seed
	run_packages_vm

	if [ "$delta" -eq 1 ]; then
		if ! grep -q 'dotfiles: delta done' "$LOG" || ! grep -q 'dotfiles-golden-ok' "$LOG"; then
			"$QEMU_IMG" snapshot -a delta-backup "$PACKAGES" >/dev/null 2>&1 || true
			"$QEMU_IMG" snapshot -d delta-backup "$PACKAGES" >/dev/null 2>&1 || true
			echo "delta failed, packages rolled back, see $LOG" >&2
			exit 1
		fi
		"$QEMU_IMG" snapshot -d delta-backup "$PACKAGES" >/dev/null 2>&1 || true
	else
		if ! grep -q 'dotfiles: provision done' "$LOG" || ! grep -q 'dotfiles-golden-ok' "$LOG"; then
			rm -f "$PACKAGES"
			echo "provision failed, see $LOG" >&2
			exit 1
		fi
	fi

	rm -f "$GOLDEN" "$CACHE/golden.sha"
	printf '%s\n' "$current" > "$stamp"
	echo "packages layer ready $PACKAGES"

	if [ "$delta" -eq 1 ]; then
		compact_packages
	fi
}

packages_seed() {
	cat > "$CACHE/seed/meta-data" <<EOF
instance-id: dotfiles-packages-$(date +%s%N)
local-hostname: yudae-guest
EOF
	{
		echo "#cloud-config"
		echo "hostname: yudae-guest"
		echo "users:"
		echo "  - default"
		echo "  - name: gabriel"
		echo "    uid: 1000"
		echo "    groups: wheel,video,render,input"
		echo "    shell: /bin/bash"
		echo "    sudo: ALL=(ALL) NOPASSWD:ALL"
		echo "    lock_passwd: true"
		echo "ssh_pwauth: false"
		echo "write_files:"
		echo "  - path: /opt/packages.txt"
		echo "    permissions: '0644'"
		echo "    content: |"
		sed 's/^/      /' "$CACHE/seed/packages.txt"
		echo "  - path: /opt/provision.sh"
		echo "    permissions: '0755'"
		echo "    content: |"
		sed 's/^/      /' "$CACHE/seed/provision.sh"
		echo "  - path: /etc/systemd/system/yudae-desktop.service"
		echo "    permissions: '0644'"
		echo "    content: |"
		desktop_unit | sed 's/^/      /'
		echo "  - path: /etc/systemd/system/yudaemond.service"
		echo "    permissions: '0644'"
		echo "    content: |"
		daemon_unit | sed 's/^/      /'
		echo "  - path: /opt/golden-setup.sh"
		echo "    permissions: '0755'"
		echo "    content: |"
		golden_setup | sed 's/^/      /'
		echo "runcmd:"
		echo "  - [ bash, /opt/provision.sh ]"
	} > "$CACHE/seed/user-data"

	rm -f "$SEED"
	truncate -s 16M "$SEED"
	mkfs.vfat -n cidata "$SEED" >/dev/null
	mcopy -i "$SEED" "$CACHE/seed/user-data" ::user-data
	mcopy -i "$SEED" "$CACHE/seed/meta-data" ::meta-data
}

run_packages_vm() {
	echo "provision $PACKAGES (log $LOG)"
	: > "$LOG"
	timeout 1200 "$QEMU" \
		-name dotfiles-packages \
		-machine q35,accel=kvm \
		-cpu host \
		-smp "$(nproc)" \
		-m 8G \
		-drive "file=$PACKAGES,if=virtio,format=qcow2,cache=unsafe,discard=unmap" \
		-drive "file=$SEED,if=virtio,format=raw,readonly=on" \
		-virtfs "local,path=/var/cache/pacman/pkg,mount_tag=hostpkg,security_model=none,readonly=on" \
		-device virtio-rng-pci \
		-netdev user,id=net0 \
		-device virtio-net-pci,netdev=net0 \
		-display none \
		-serial "file:$LOG" \
		-no-reboot
}

compact_packages() {
	local cap=${DOTFILES_VM_PACKAGES_CAP_MB:-8192} mb tmp
	mb=$(du -sm "$PACKAGES" | cut -f1)
	[ "$mb" -le "$cap" ] && return
	tmp=$PACKAGES.compact
	rm -f "$tmp"
	if "$QEMU_IMG" convert -O qcow2 -o lazy_refcounts=on -b "$CLOUD" -F qcow2 "$PACKAGES" "$tmp"; then
		mv "$tmp" "$PACKAGES"
		echo "compacted packages layer to $(du -sm "$PACKAGES" | cut -f1)MB"
	else
		rm -f "$tmp"
	fi
}

