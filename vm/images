cmd_golden() {
	if [ ! -f "$PACKAGES" ] || [ ! -f "$CACHE/packages.sha" ]; then
		cmd_packages
	fi

	mkdir -p "$CACHE"
	local stamp=$CACHE/golden.sha current want
	want=$(packages_want)
	if [ "$(cat "$CACHE/packages.sha" 2>/dev/null)" != "$want" ]; then
		cmd_packages
	fi
	current=$(cat "$CACHE/packages.sha")

	if [ "$FORCE" -eq 0 ] && [ -f "$GOLDEN" ] && [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$current" ]; then
		echo "golden layer cached $GOLDEN"
		return
	fi

	if vms_exist; then
		echo "refused: VMs exist under $RUNS; destroy them first (yudae vm list)" >&2
		exit 1
	fi

	rm -f "$GOLDEN"
	"$QEMU_IMG" create -f qcow2 -o lazy_refcounts=on -F qcow2 -b "$PACKAGES" "$GOLDEN" 32G
	printf '%s\n' "$current" > "$stamp"
	echo "golden layer ready $GOLDEN"
}

cmd_ensure() {
	[ -f "$GOLDEN" ] && return
	cmd_golden
}

cmd_overlay() {
	[ $# -ge 1 ] || usage
	local name=$1
	local base=${2:-}
	if [ -n "$base" ]; then
		local golden="$CACHE/golden-$base.qcow2"
		[ "$base" = current ] && golden=$GOLDEN
		[ -f "$golden" ] || { echo "golden $base not built" >&2; exit 1; }
	else
		cmd_ensure
		local golden="$GOLDEN"
	fi
	mkdir -p "$RUNS/$name"
	rm -f "$RUNS/$name/disk.qcow2"
	"$QEMU_IMG" create -f qcow2 -F qcow2 -b "$golden" "$RUNS/$name/disk.qcow2" 32G
	echo "$RUNS/$name/disk.qcow2"
}

cmd_snapshot() {
	[ $# -ge 2 ] || usage
	"$QEMU_IMG" snapshot -c "$2" "$RUNS/$1/disk.qcow2"
	"$QEMU_IMG" snapshot -l "$RUNS/$1/disk.qcow2"
}

cmd_restore() {
	[ $# -ge 2 ] || usage
	"$QEMU_IMG" snapshot -a "$2" "$RUNS/$1/disk.qcow2"
	echo "restored $2"
}

cmd_list() {
	local golden tag
	for golden in "$CACHE"/golden*.qcow2; do
		[ -f "$golden" ] || continue
		tag=$(basename "$golden" .qcow2)
		tag=${tag#golden-}
		[ "$tag" = "golden" ] && tag=current
		echo "golden $tag"
	done
	find "$RUNS" -maxdepth 2 -name disk.qcow2 -printf '%h\n' 2>/dev/null | xargs -r -n1 basename
}

command=${1:-}
shift || true

case "$command" in
	fetch) cmd_fetch ;;
	packages|golden)
		while [ $# -gt 0 ]; do
			case "$1" in
				--snapshot)
					shift
					[ $# -gt 0 ] || usage
					ARCH_SNAPSHOT=$1
					;;
				--force)
					FORCE=1
					;;
				*) usage ;;
			esac
			shift
		done
		if [ -n "$ARCH_SNAPSHOT" ]; then
			slug=$(echo "$ARCH_SNAPSHOT" | tr '/' '-')
			PACKAGES=$CACHE/packages-$slug.qcow2
			GOLDEN=$CACHE/golden-$slug.qcow2
		fi
		if [ "$command" = packages ]; then cmd_packages; else cmd_golden; fi
		;;
	ensure) cmd_ensure ;;
	overlay) cmd_overlay "$@" ;;
	snapshot) cmd_snapshot "$@" ;;
	restore) cmd_restore "$@" ;;
	list) cmd_list ;;
	*) usage ;;
esac
