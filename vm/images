}

provision_script() {
	cat <<'SCRIPT'
#!/bin/bash
set -u
exec > >(tee /dev/console) 2>&1
echo "dotfiles: provision start"
@SNAPSHOT@
sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 12/' /etc/pacman.conf
sed -i 's|^#\?CacheDir.*|CacheDir = /var/cache/pacman/pkg /mnt/hostpkg|' /etc/pacman.conf
grep -q '^CacheDir' /etc/pacman.conf || echo 'CacheDir = /var/cache/pacman/pkg /mnt/hostpkg' >> /etc/pacman.conf
mkdir -p /mnt/hostpkg
mountpoint -q /mnt/hostpkg || mount -t 9p -o trans=virtio,version=9p2000.L hostpkg /mnt/hostpkg
mkdir -p /var/cache/pacman/pkg
for pkg in /mnt/hostpkg/*.pkg.tar.zst /mnt/hostpkg/*.pkg.tar.xz; do
	[ -e "$pkg" ] || continue
	ln -sf "$pkg" "/var/cache/pacman/pkg/$(basename "$pkg")"
done
rm -f /var/cache/pacman/pkg/limine-* /var/cache/pacman/pkg/plymouth-*
pacman -Sy --noconfirm >/dev/null 2>&1
vm_exclude='@EXCLUDE@'
grep -vE "$vm_exclude" /opt/packages.txt > /tmp/candidates.txt
pacman -Slq | grep -Fxf /tmp/candidates.txt > /tmp/install.txt 2>/dev/null || true
{ pacman -Sp --needed --noconfirm $(cat /tmp/install.txt); pacman -Spu --needed --noconfirm --ignore linux,linux-firmware,linux-headers $(cat /tmp/install.txt); } 2>/dev/null | grep '^http' | sort -u > /tmp/urls.txt || true
cp /tmp/urls.txt /mnt/hostpkg/urls.txt 2>/dev/null || true
pacman -Syu --needed --noconfirm --ignore linux,linux-firmware,linux-headers $(cat /tmp/install.txt) 2>&1 | tee /tmp/pacman.log
if grep -q 'failed to commit transaction' /tmp/pacman.log; then
	grep 'signature from' /tmp/pacman.log | sed 's/^error: //; s/:.*//' | while read -r name; do
		rm -f /var/cache/pacman/pkg/"$name"-*.pkg.tar.*
	done
	pacman -Syu --needed --noconfirm --ignore linux,linux-firmware,linux-headers $(cat /tmp/install.txt)
fi
for pkg in /var/cache/pacman/pkg/*.pkg.tar.zst; do
	[ -f "$pkg" ] || continue
	name=$(basename "$pkg")
	[ -e "/mnt/hostpkg/$name" ] || cp "$pkg" "/mnt/hostpkg/$name" 2>/dev/null || true
done
pacman -Scc --noconfirm >/dev/null 2>&1 || true
cp /tmp/install.txt /opt/packages.installed
fstrim -av >/dev/null 2>&1 || true
bash /opt/golden-setup.sh
tar -C /var/lib/pacman -cf /mnt/hostpkg/pacman-local.tar local 2>/dev/null || true
grep -a 'Packages (' /tmp/pacman.log | head -1 | sed 's/.*Packages ([0-9]*) //' | tr ' ' '\n' > /mnt/hostpkg/transaction.txt 2>/dev/null || true
touch /var/lib/dotfiles-provisioned
echo "dotfiles: provision done"
poweroff
SCRIPT
}

delta_script() {
	cat <<'SCRIPT'
#!/bin/bash
set -u
exec > >(tee /dev/console) 2>&1
echo "dotfiles: delta start"
@SNAPSHOT@
sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 12/' /etc/pacman.conf
sed -i 's|^#\?CacheDir.*|CacheDir = /var/cache/pacman/pkg /mnt/hostpkg|' /etc/pacman.conf
grep -q '^CacheDir' /etc/pacman.conf || echo 'CacheDir = /var/cache/pacman/pkg /mnt/hostpkg' >> /etc/pacman.conf
mkdir -p /mnt/hostpkg
mountpoint -q /mnt/hostpkg || mount -t 9p -o trans=virtio,version=9p2000.L hostpkg /mnt/hostpkg
mkdir -p /var/cache/pacman/pkg
for pkg in /mnt/hostpkg/*.pkg.tar.zst /mnt/hostpkg/*.pkg.tar.xz; do
	[ -e "$pkg" ] || continue
	ln -sf "$pkg" "/var/cache/pacman/pkg/$(basename "$pkg")"
done
rm -f /var/cache/pacman/pkg/limine-* /var/cache/pacman/pkg/plymouth-*
pacman -Sy --noconfirm >/dev/null 2>&1
vm_exclude='@EXCLUDE@'
grep -vE "$vm_exclude" /opt/packages.txt > /tmp/candidates.txt
pacman -Slq | grep -Fxf /tmp/candidates.txt > /tmp/install.txt 2>/dev/null || true
{ pacman -Sp --needed --noconfirm $(cat /tmp/install.txt); pacman -Spu --needed --noconfirm --ignore linux,linux-firmware,linux-headers $(cat /tmp/install.txt); } 2>/dev/null | grep '^http' | sort -u > /tmp/urls.txt || true
cp /tmp/urls.txt /mnt/hostpkg/urls.txt 2>/dev/null || true
if [ -f /opt/packages.installed ]; then
	sort -u /opt/packages.installed > /tmp/old.txt
	sort -u /tmp/install.txt > /tmp/new.txt
	comm -23 /tmp/old.txt /tmp/new.txt > /tmp/remove.txt
	if [ -s /tmp/remove.txt ]; then
		pacman -Rns --noconfirm $(cat /tmp/remove.txt) 2>&1 | tee /tmp/pacman-remove.log || pacman -R --noconfirm $(cat /tmp/remove.txt) 2>&1 | tee -a /tmp/pacman-remove.log || true
	fi
fi
pacman -Syu --needed --noconfirm --ignore linux,linux-firmware,linux-headers $(cat /tmp/install.txt) 2>&1 | tee /tmp/pacman.log
if grep -q 'failed to commit transaction' /tmp/pacman.log; then
	grep 'signature from' /tmp/pacman.log | sed 's/^error: //; s/:.*//' | while read -r name; do
		rm -f /var/cache/pacman/pkg/"$name"-*.pkg.tar.*
	done
	pacman -Syu --needed --noconfirm --ignore linux,linux-firmware,linux-headers $(cat /tmp/install.txt)
fi
orphans=$(pacman -Qtdq)
[ -z "$orphans" ] || pacman -Rns --noconfirm $orphans >/dev/null 2>&1 || true
cp /tmp/install.txt /opt/packages.installed
bash /opt/golden-setup.sh
for pkg in /var/cache/pacman/pkg/*.pkg.tar.zst; do
	[ -f "$pkg" ] || continue
	name=$(basename "$pkg")
	[ -e "/mnt/hostpkg/$name" ] || cp "$pkg" "/mnt/hostpkg/$name" 2>/dev/null || true
done
pacman -Scc --noconfirm >/dev/null 2>&1 || true
fstrim -av >/dev/null 2>&1 || true
echo "dotfiles: delta done"
poweroff
SCRIPT
}

vms_exist() {
	[ -d "$RUNS" ] || return 1
	find "$RUNS" -mindepth 2 -maxdepth 2 -name disk.qcow2 -print -quit 2>/dev/null | grep -q .
}

packages_want() {
	{ cat "$CACHE/seed/packages.txt" 2>/dev/null; printf '%s\n' "$ARCH_SNAPSHOT" "$CLOUD_NAME"; provision_script; delta_script; } | sha256sum | cut -d' ' -f1
}

userns_run() {
	local uid gid ustart ucount gstart gcount
	uid=$(id -u)
	gid=$(id -g)
	read -r ustart ucount < <(awk -F: -v u="$(id -un)" '$1 == u { print $2, $3; exit }' /etc/subuid)
	read -r gstart gcount < <(awk -F: -v g="$(id -gn)" '$1 == g { print $2, $3; exit }' /etc/subgid)
	[ -n "$ustart" ] && [ -n "$gstart" ] && [ "$ucount" -gt 1 ] && [ "$gcount" -gt 1 ] || return 1
	unshare --user \
		--map-users=0:$uid:1 --map-users=1:$ustart:$((ucount - 1)) \
		--map-groups=0:$gid:1 --map-groups=1:$gstart:$((gcount - 1)) -- "$@"
}

build_dcopy() {
	local bin=$BASE/dcopy
	mkdir -p "$BASE"
	if [ ! -x "$bin" ] || [ "$ROOT/vm/dcopy/main.go" -nt "$bin" ]; then
		(cd "$ROOT/vm/dcopy" && CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o "$bin" .) || return 1
	fi
}

prefetch_rootfs() {
	userns_run bash -c 'find "$1" -type f -print0 2>/dev/null | xargs -0 -P 8 cat >/dev/null 2>&1' _ "$ROOTFS"
}

make_disk_head() {
	local want=""
	case $DISK_SIZE in
		32G) want=$((32 * 1024 * 1024 * 1024)) ;;
		7G) want=$((7 * 1024 * 1024 * 1024)) ;;
		6G) want=$((6 * 1024 * 1024 * 1024)) ;;
	esac
	if [ -f "$DISK_HEAD" ] && { [ -z "$want" ] || [ "$(stat -c %s "$DISK_HEAD")" = "$want" ]; }; then
		return 0
	fi
	command -v sfdisk >/dev/null 2>&1 || return 1
	[ -f "$CLOUD" ] || return 1
	mkdir -p "$BASE"
	local raw=$CACHE/cloud.raw
	"$QEMU_IMG" convert -f qcow2 -O raw "$CLOUD" "$raw" || return 1
	dd if="$raw" of="$DISK_HEAD" bs=512 count=618496 status=none || return 1
	truncate -s "$DISK_SIZE" "$DISK_HEAD"
	echo ', +' | sfdisk --force -N 3 "$DISK_HEAD" >/dev/null 2>&1 || return 1
	rm -f "$raw"
}

slice_root_image() {
	[ -f "$PACKAGES" ] || return 1
	[ "$DISK_SIZE" = 32G ] || return 1
	command -v qemu-img numfmt >/dev/null 2>&1 || return 1
	local raw=$CACHE/packages.disk bytes
	bytes=$(numfmt --from=iec "$DISK_SIZE") || return 1
	"$QEMU_IMG" convert -f qcow2 -O raw "$PACKAGES" "$raw" || return 1
	build_dcopy || return 1
	rm -f "$ROOT_IMG_CACHE"
	"$BASE/dcopy" "$raw" "$ROOT_IMG_CACHE" 0 $((302 * 1024 * 1024)) || return 1
	truncate -s $((bytes - 302 * 1024 * 1024)) "$ROOT_IMG_CACHE"
	rm -f "$raw"
	if command -v btrfs >/dev/null 2>&1 && ! btrfs check --readonly "$ROOT_IMG_CACHE" >/dev/null 2>&1; then
		rm -f "$ROOT_IMG_CACHE"
		return 1
	fi
	printf '%s\n' "$(packages_want)" > "$ROOT_IMG_SHA"
}

root_source_ready() {
	[ -f "$ROOT_IMG_CACHE" ] && [ -f "$ROOT_IMG_SHA" ] && [ "$(cat "$ROOT_IMG_SHA")" = "$(packages_want)" ] && return 0
	[ -d "$ROOTFS" ] && [ -f "$ROOTFS_SHA" ] && [ "$(cat "$ROOTFS_SHA")" = "$(packages_want)" ] && return 0
	return 1
}

materialize_packages() {
	make_disk_head || return 1
	command -v go >/dev/null 2>&1 || return 1

	local raw=$CACHE/packages.raw image=$CACHE/root.btrfs current
	current=$(packages_want)
	mkdir -p "$CACHE"
	cp --reflink=auto "$DISK_HEAD" "$raw"
	build_dcopy || return 1
	if [ -f "$ROOT_IMG_CACHE" ] && [ -f "$ROOT_IMG_SHA" ] && [ "$(cat "$ROOT_IMG_SHA")" = "$current" ]; then
		"$BASE/dcopy" "$ROOT_IMG_CACHE" "$raw" $((302 * 1024 * 1024)) || return 1
		rm -f "$PACKAGES"
		"$QEMU_IMG" create -f qcow2 -o lazy_refcounts=on -F raw -b "$raw" "$PACKAGES" >/dev/null
		echo "packages layer cached"
		return 0
	fi

	[ -d "$ROOTFS" ] && [ -f "$ROOTFS_SHA" ] && [ "$(cat "$ROOTFS_SHA")" = "$current" ] || return 1
	command -v mkfs.btrfs >/dev/null 2>&1 || return 1
	rm -f "$image"
	truncate -s "$ROOT_IMG" "$image"
	prefetch_rootfs &
	userns_run mkfs.btrfs -q -m single -d single -K --nodesize 4096 --csum xxhash \
		-O ^free-space-tree,^block-group-tree -r "$ROOTFS" -U "$ROOT_UUID" -L root "$image" || return 1
	wait || true
	"$BASE/dcopy" "$image" "$raw" $((302 * 1024 * 1024)) || return 1
	if [ -z "$ARCH_SNAPSHOT" ] && cp --reflink=auto "$image" "$ROOT_IMG_CACHE.tmp"; then
		mv "$ROOT_IMG_CACHE.tmp" "$ROOT_IMG_CACHE"
		printf '%s\n' "$current" > "$ROOT_IMG_SHA"
	fi
	rm -f "$image" "$PACKAGES"
	"$QEMU_IMG" create -f qcow2 -o lazy_refcounts=on -F raw -b "$raw" "$PACKAGES" >/dev/null
}

build_parallel() {
	[ -z "$ARCH_SNAPSHOT" ] || return 1
	[ -f "$CACHE/direct/initramfs.img" ] || return 1
	[ -f "$CACHE/seed/packages.txt" ] || return 1
	[ -d "$PKGSTORE" ] || return 1
	command -v qemu-img sfdisk mcopy mkfs.vfat >/dev/null 2>&1 || return 1

	local target=$CACHE/parallel-target.qcow2 builder=$CACHE/parallel-builder.qcow2 seed=$CACHE/parallel-seed.img log=$CACHE/parallel.log
	rm -f "$target" "$builder" "$seed" "$log"
	parallel_script | sed "s#@EXCLUDE@#$VM_EXCLUDE#" > "$CACHE/seed/parallel.sh"
	truncate -s 32M "$seed"
	mkfs.vfat -n cidata "$seed" >/dev/null 2>&1 || return 1
	mcopy -i "$seed" "$CACHE/seed/parallel.sh" ::boot.sh || return 1
	mcopy -i "$seed" "$CACHE/seed/packages.txt" ::packages.txt || return 1
	local f
	for f in yudae-desktop.service yudaemond.service; do
		mcopy -i "$seed" "$CACHE/seed/$f" "::$f" || return 1
	done
	cat > "$CACHE/seed/parallel.service" <<'UNIT'
[Unit]
Description=dotfiles parallel build
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/bin/bash /mnt/seed/boot.sh
StandardOutput=journal+console
StandardError=journal+console
[Install]
WantedBy=provision.target
UNIT
	cat > "$CACHE/seed/parallel.target" <<'UNIT'
[Unit]
Description=dotfiles parallel build
Requires=provision.service
After=provision.service
UNIT
	mcopy -i "$seed" "$CACHE/seed/parallel.service" ::provision.service || return 1
	mcopy -i "$seed" "$CACHE/seed/parallel.target" ::provision.target || return 1
	local current
	current=$(packages_want)
	if [ -f "$PKGSTORE/parallel.sha" ] && [ "$(cat "$PKGSTORE/parallel.sha")" = "$current" ] &&
		[ -f "$PKGSTORE/files.txt" ] && [ -f "$PKGSTORE/pacman-local.tar" ]; then
		: > "$CACHE/seed/fast"
		mcopy -i "$seed" "$CACHE/seed/fast" ::fast || return 1
	else
		rm -f "$CACHE/seed/fast"
	fi

	"$QEMU_IMG" create -f qcow2 -o lazy_refcounts=on -b "$CLOUD" -F qcow2 "$builder" 32G >/dev/null || return 1
	"$QEMU_IMG" create -f qcow2 -o lazy_refcounts=on -b "$CLOUD" -F qcow2 "$target" 32G >/dev/null || return 1
	echo "parallel build start"
	timeout 600 "$QEMU" -name dotfiles-parallel -machine q35,accel=kvm -cpu host -smp "$(nproc)" -m 8G \
		-kernel "$(cat "$CACHE/direct/kernel")" -initrd "$CACHE/direct/initramfs.img" \
		-append "console=ttyS0 root=/dev/vda3 rw dotfiles.parallel=1" \
		-drive "file=$builder,if=virtio,format=qcow2,cache=writeback" \
		-drive "file=$seed,if=virtio,format=raw,readonly=on" \
		-drive "file=$target,if=virtio,format=qcow2,cache=writeback" \
		-virtfs "local,path=$PKGSTORE,mount_tag=hostpkg,security_model=none" \
		-device virtio-rng-pci -netdev user,id=net0 -device virtio-net-pci,netdev=net0 \
		-display none -serial "file:$log" -no-reboot || true
	grep -q 'dotfiles: parallel done' "$log" || { rm -f "$target" "$builder" "$seed"; return 1; }
	cp --reflink=auto "$target" "$PACKAGES" || { rm -f "$target" "$builder" "$seed"; return 1; }
	rm -f "$target" "$builder" "$seed"
	slice_root_image || true
	echo "parallel build ready"
}

cmd_packages() {
	mkdir -p "$CACHE/seed"
	local source=${DOTFILES_VM_PACKAGES:-}
	if [ -n "$source" ]; then
		cp "$source" "$CACHE/seed/packages.txt"
	else
		pacman -Qqen > "$CACHE/seed/packages.txt"
	fi

	local stamp=$CACHE/packages.sha current delta=0
	current=$(packages_want)

	if [ "$FORCE" -eq 0 ] && [ -f "$PACKAGES" ] && [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$current" ]; then
		echo "packages layer cached $PACKAGES"
		return
	fi

	if vms_exist; then
		echo "refused: VMs exist under $RUNS; destroy them first (yudae vm list)" >&2
		exit 1
	fi

	if [ -z "$ARCH_SNAPSHOT" ] && root_source_ready; then
		if materialize_packages; then
			rm -f "$GOLDEN" "$CACHE/golden.sha"
			printf '%s\n' "$current" > "$stamp"
			echo "packages layer materialized $PACKAGES"
			return
		fi
		echo "materialize failed, falling back to pacman" >&2
	fi

	if [ "$FORCE" -eq 0 ] && [ -z "$ARCH_SNAPSHOT" ] && [ -f "$BASE/packages.qcow2" ] && [ -f "$BASE/packages.sha" ] && [ -f "$BASE/cloud.qcow2" ] && [ "$(cat "$BASE/packages.sha")" = "$current" ]; then
		mkdir -p "$CACHE"
		cp --reflink=auto "$BASE/packages.qcow2" "$PACKAGES"
		rm -f "$GOLDEN" "$CACHE/golden.sha"
		printf '%s\n' "$current" > "$stamp"
		echo "packages layer restored $PACKAGES"
		return
	fi

	cmd_fetch

	if [ -f "$PACKAGES" ] && [ "$FORCE" -eq 0 ]; then
		delta=1
	else
		: > "$CACHE/seed/provision.sh"
		packages_seed
		direct_initramfs || true
		if build_parallel; then
			rm -f "$GOLDEN" "$CACHE/golden.sha"
			printf '%s\n' "$current" > "$stamp"
			echo "packages layer ready $PACKAGES"
			if [ -z "$ARCH_SNAPSHOT" ]; then
				mkdir -p "$BASE"
				cp --reflink=auto "$PACKAGES" "$BASE/packages.qcow2"
				cp "$stamp" "$BASE/packages.sha"
			fi
			return
		fi
		echo "parallel build failed, falling back to pacman" >&2
		mkdir -p "$CACHE"
		rm -f "$PACKAGES"
		"$QEMU_IMG" create -f qcow2 -o lazy_refcounts=on -F qcow2 -b "$CLOUD" "$PACKAGES" 32G
	fi

	local snapshot_line=""
	if [ -n "$ARCH_SNAPSHOT" ]; then
		snapshot_line="echo 'Server = https://archive.archlinux.org/repos/${ARCH_SNAPSHOT}/\$repo/os/\$arch' > /etc/pacman.d/mirrorlist"
	fi

	if [ "$delta" -eq 1 ]; then
		delta_script | sed "s|@SNAPSHOT@|$snapshot_line|; s#@EXCLUDE@#$VM_EXCLUDE#" > "$CACHE/seed/provision.sh"
		if "$QEMU_IMG" snapshot -l "$PACKAGES" 2>/dev/null | grep -q delta-backup; then
			"$QEMU_IMG" snapshot -a delta-backup "$PACKAGES" >/dev/null 2>&1 || true
			"$QEMU_IMG" snapshot -d delta-backup "$PACKAGES" >/dev/null 2>&1 || true
		fi
		"$QEMU_IMG" snapshot -c delta-backup "$PACKAGES" >/dev/null
	else
		provision_script | sed "s|@SNAPSHOT@|$snapshot_line|; s#@EXCLUDE@#$VM_EXCLUDE#" > "$CACHE/seed/provision.sh"
	fi

	packages_seed
	direct_initramfs || true
	run_packages_vm

	if [ "$delta" -eq 1 ]; then
		if ! grep -q 'dotfiles: delta done' "$LOG" || ! grep -q 'dotfiles-golden-ok' "$LOG"; then
			"$QEMU_IMG" snapshot -a delta-backup "$PACKAGES" >/dev/null 2>&1 || true
			"$QEMU_IMG" snapshot -d delta-backup "$PACKAGES" >/dev/null 2>&1 || true
			echo "delta failed, packages rolled back, see $LOG" >&2
			exit 1
		fi
		"$QEMU_IMG" snapshot -d delta-backup "$PACKAGES" >/dev/null 2>&1 || true
	else
		if ! grep -q 'dotfiles: provision done' "$LOG" || ! grep -q 'dotfiles-golden-ok' "$LOG"; then
			rm -f "$PACKAGES"
			echo "provision failed, see $LOG" >&2
			exit 1
		fi
	fi

	rm -f "$GOLDEN" "$CACHE/golden.sha"
	printf '%s\n' "$current" > "$stamp"
	echo "packages layer ready $PACKAGES"

	if [ "$delta" -eq 1 ]; then
		compact_packages
	fi

	if [ -z "$ARCH_SNAPSHOT" ]; then
		mkdir -p "$BASE"
		cp --reflink=auto "$PACKAGES" "$BASE/packages.qcow2"
		cp "$stamp" "$BASE/packages.sha"
		if [ "$delta" -eq 0 ]; then
			printf '%s\n' "$current" > "$PKGSTORE/parallel.sha"
		fi
		slice_root_image || echo "root image cache skipped" >&2
	fi
}

