direct_initramfs() {
	local dir=$CACHE/direct kver kernel module file
	kver=$(uname -r)
	kernel=/usr/lib/modules/$kver/vmlinuz
	[ -f "$kernel" ] || return 1
	command -v go >/dev/null 2>&1 || return 1

	mkdir -p "$dir/initramfs/modules"
	if [ ! -x "$dir/init" ] || [ "$ROOT/vm/direct-init/main.go" -nt "$dir/init" ]; then
		(cd "$ROOT/vm/direct-init" && CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o "$dir/init" .) || return 1
	fi
	cp -f "$dir/init" "$dir/initramfs/init"
	chmod 755 "$dir/initramfs/init"

	for module in fat vfat failover net_failover virtio_net netfs 9pnet 9p 9pnet_virtio; do
		file=$(find "/usr/lib/modules/$kver/kernel" -name "$module.ko.zst" -print -quit)
		[ -n "$file" ] || return 1
		zstd -q -d -f "$file" -o "$dir/initramfs/modules/$module.ko" || return 1
	done

	(cd "$dir/initramfs" && find . -print0 | cpio --null -o -H newc 2>/dev/null | gzip -9) > "$dir/initramfs.img" || return 1
	printf '%s\n' "$kernel" > "$dir/kernel"
}

prefetch_packages() {
	local urls=$PKGSTORE/urls.txt
	[ -f "$urls" ] || return 0
	export PKGSTORE
	export MIRRORS="https://geo.mirror.pkgbuild.com https://mirror.rackspace.com/archlinux https://mirrors.kernel.org/archlinux https://archlinux.mirror.wearetriple.com"
	awk 'NF && $0 !~ /^#/' "$urls" | xargs -P 12 -I{} sh -c '
		url=$1
		name=$(basename "$url")
		[ -f "$PKGSTORE/$name" ] && exit 0
		path=$(printf "%s" "$url" | sed -E "s#^https?://[^/]+##")
		mirror=$(printf "%s\n" $MIRRORS | shuf -n1)
		curl -fsSL --retry 1 -o "$PKGSTORE/$name.part" "$mirror$path" && mv "$PKGSTORE/$name.part" "$PKGSTORE/$name"
	' _ {}
}

run_packages_vm() {
	echo "provision $PACKAGES (log $LOG)"
	: > "$LOG"

	mkdir -p "$PKGSTORE"
	if [ -z "$(find "$PKGSTORE" -maxdepth 1 -name '*.pkg.tar.zst' -print -quit)" ]; then
		find "$CACHE/pkgcache" -maxdepth 1 -type f -exec cp -n {} "$PKGSTORE/" \; 2>/dev/null || true
	fi
	[ -f "$PKGSTORE/urls.txt" ] || cp "$CACHE/pkgcache/urls.txt" "$PKGSTORE/" 2>/dev/null || true
	[ -d "$PKGSTORE/gnupg" ] || cp -a "$CACHE/pkgcache/gnupg" "$PKGSTORE/" 2>/dev/null || true

	(prefetch_packages) &

	local direct=0
	[ -f "$CACHE/direct/initramfs.img" ] && [ -f "$CACHE/direct/kernel" ] && direct=1

	if [ "$direct" -eq 1 ]; then
		timeout 1200 "$QEMU" \
			-name dotfiles-packages \
			-machine q35,accel=kvm \
			-cpu host \
			-smp "$(nproc)" \
			-m 8G \
			-kernel "$(cat "$CACHE/direct/kernel")" \
			-initrd "$CACHE/direct/initramfs.img" \
			-append "console=ttyS0 root=/dev/vda3 rw systemd.unit=provision.target" \
			-drive "file=$PACKAGES,if=virtio,format=qcow2,cache=unsafe,discard=unmap" \
			-drive "file=$SEED,if=virtio,format=raw,readonly=on" \
			-virtfs "local,path=$PKGSTORE,mount_tag=hostpkg,security_model=none" \
			-device virtio-rng-pci \
			-netdev user,id=net0 \
			-device virtio-net-pci,netdev=net0 \
			-display none \
			-serial "file:$LOG" \
			-no-reboot
	else
		timeout 1200 "$QEMU" \
			-name dotfiles-packages \
			-machine q35,accel=kvm \
			-cpu host \
			-smp "$(nproc)" \
			-m 8G \
			-drive "file=$PACKAGES,if=virtio,format=qcow2,cache=unsafe,discard=unmap" \
			-drive "file=$SEED,if=virtio,format=raw,readonly=on" \
			-virtfs "local,path=$PKGSTORE,mount_tag=hostpkg,security_model=none" \
			-device virtio-rng-pci \
			-netdev user,id=net0 \
			-device virtio-net-pci,netdev=net0 \
			-display none \
			-serial "file:$LOG" \
			-no-reboot
	fi
}

compact_packages() {
	local cap=${DOTFILES_VM_PACKAGES_CAP_MB:-8192} mb tmp
	mb=$(du -sm "$PACKAGES" | cut -f1)
	[ "$mb" -le "$cap" ] && return
	tmp=$PACKAGES.compact
	rm -f "$tmp"
	if "$QEMU_IMG" convert -O qcow2 -o lazy_refcounts=on -b "$CLOUD" -F qcow2 "$PACKAGES" "$tmp"; then
		mv "$tmp" "$PACKAGES"
		echo "compacted packages layer to $(du -sm "$PACKAGES" | cut -f1)MB"
	else
		rm -f "$tmp"
	fi
}

