mirrors=(
	https://geo.mirror.pkgbuild.com
	https://mirror.rackspace.com/archlinux
	https://mirrors.kernel.org/archlinux
	https://archlinux.mirror.wearetriple.com
	https://mirror.funami.tech/archlinux
)

usage() {
	echo "usage: vm/images fetch|packages [--snapshot YYYY/MM/DD] [--force]|golden [--snapshot YYYY/MM/DD] [--force]|ensure|overlay <name> [golden-tag]|snapshot <name> <tag>|restore <name> <tag>|list" >&2
	exit 2
}

speed_pick() {
	local best="" best_speed=0 mirror speed url
	for mirror in "${mirrors[@]}"; do
		url="$mirror/images/latest/$CLOUD_NAME"
		speed=$(curl -fsSL --max-time 15 -r 0-2097151 -o /dev/null -w '%{speed_download}' "$url" 2>/dev/null || echo 0)
		echo "probe $mirror ${speed%.*}B/s" >&2
		if [ "${speed%.*}" -gt "$best_speed" ]; then
			best_speed=${speed%.*}
			best=$url
		fi
	done
	[ -n "$best" ] || best="https://geo.mirror.pkgbuild.com/images/latest/$CLOUD_NAME"
	echo "$best"
}

cloud_mark() {
	{ stat -c '%s %Y' "$CLOUD"; printf '%s\n' "$CLOUD_SHA"; } > "$BASE/cloud.stamp"
}

cmd_fetch() {
	mkdir -p "$BASE"
	local mark=$BASE/cloud.stamp
	if [ -f "$CLOUD" ] && [ -f "$mark" ] &&
		[ "$(head -1 "$mark")" = "$(stat -c '%s %Y' "$CLOUD")" ] &&
		[ "$(tail -1 "$mark")" = "$CLOUD_SHA" ]; then
		echo "cloud image cached $CLOUD"
		return
	fi
	if [ -f "$CLOUD" ] && [ "$(sha256sum "$CLOUD" | cut -d' ' -f1)" = "$CLOUD_SHA" ]; then
		cloud_mark
		echo "cloud image cached $CLOUD"
		return
	fi
	if [ -f "$CACHE/$CLOUD_NAME" ] && [ "$(sha256sum "$CACHE/$CLOUD_NAME" | cut -d' ' -f1)" = "$CLOUD_SHA" ]; then
		cp --reflink=auto "$CACHE/$CLOUD_NAME" "$CLOUD"
		cloud_mark
		echo "cloud image promoted $CLOUD"
		return
	fi
	local url
	url=$(speed_pick)
	echo "download $url"
	curl -fL --retry 3 --progress-bar -o "$CLOUD.part" "$url"
	echo "$CLOUD_SHA  $CLOUD.part" | sha256sum -c -
	mv "$CLOUD.part" "$CLOUD"
	cloud_mark
}

parallel_script() {
	cat <<'SCRIPT'
#!/bin/bash
set -u
echo "dotfiles: parallel start"
vm_exclude='@EXCLUDE@'
mkdir -p /mnt/seed /mnt/hostpkg /target
mountpoint -q /mnt/seed || mount -t vfat /dev/vdb /mnt/seed
mountpoint -q /mnt/hostpkg || mount -t 9p -o trans=virtio,version=9p2000.L hostpkg /mnt/hostpkg
if [ -f /mnt/seed/fast ] && [ -s /mnt/hostpkg/files.txt ] && [ -f /mnt/hostpkg/pacman-local.tar ]; then
	sed 's#^#/mnt/hostpkg/#' /mnt/hostpkg/files.txt > /tmp/files.txt
	echo "dotfiles: parallel fast list $(wc -l < /tmp/files.txt)"
else
	systemctl stop systemd-resolved systemd-networkd NetworkManager 2>/dev/null || true
	iface=$(ip -o link show | awk -F': ' '$2 != "lo" {print $2; exit}')
	[ -n "$iface" ] || iface=eth0
	ip link set "$iface" up 2>/dev/null || true
	ip addr replace 10.0.2.15/24 dev "$iface" 2>/dev/null || true
	ip route replace default via 10.0.2.2 2>/dev/null || true
	rm -f /etc/resolv.conf
	printf 'nameserver 10.0.2.3\n' > /etc/resolv.conf
	pacman -Sy --noconfirm >/dev/null 2>&1 || { echo "dotfiles: parallel sync failed"; poweroff -f; exit 1; }
	grep -vE "$vm_exclude" /mnt/seed/packages.txt > /tmp/candidates.txt
	pacman -Slq | grep -Fxf /tmp/candidates.txt > /tmp/install.txt 2>/dev/null || true
	[ -s /tmp/install.txt ] || { echo "dotfiles: parallel no candidates"; poweroff -f; exit 1; }
	pacman -Syu --print-format '%n-%v' --needed --noconfirm --ignore linux,linux-firmware,linux-headers $(cat /tmp/install.txt) > /tmp/txn.raw 2>/tmp/txn.err || true
	grep -E '^[A-Za-z0-9@._+:-]+-[^-]+-[^-]+$' /tmp/txn.raw | sort -u > /tmp/names.txt
	[ -s /tmp/names.txt ] || { echo "dotfiles: parallel resolve failed"; tail -3 /tmp/txn.err; poweroff -f; exit 1; }
	: > /tmp/files.txt
	while read -r name; do
		f=$(ls /mnt/hostpkg/"$name"-*.pkg.tar.zst 2>/dev/null | head -1)
		[ -n "$f" ] || { echo "dotfiles: parallel missing $name"; poweroff -f; exit 1; }
		echo "$f" >> /tmp/files.txt
	done < /tmp/names.txt
fi
growpart /dev/vdc 3 >/dev/null 2>&1 || true
partx -u /dev/vdc >/dev/null 2>&1 || true
mount /dev/vdc3 /target || { echo "dotfiles: parallel mount failed"; poweroff -f; exit 1; }
btrfs filesystem resize max /target >/dev/null 2>&1 || true
echo "dotfiles: parallel files $(wc -l < /tmp/files.txt)"
xargs -a /tmp/files.txt -P 16 -I{} bsdtar -xpf {} -C /target --exclude=.PKGINFO --exclude=.MTREE --exclude=.INSTALL --exclude=.BUILDINFO 2>/tmp/extract.err
echo "dotfiles: parallel extracted $(wc -l < /tmp/extract.err)"
if [ -f /mnt/seed/fast ] && [ -f /mnt/hostpkg/pacman-local.tar ]; then
	rm -rf /target/var/lib/pacman/local
	tar -C /target/var/lib/pacman -xf /mnt/hostpkg/pacman-local.tar || { echo "dotfiles: parallel db tar failed"; poweroff -f; exit 1; }
else
	pacman -U --dbonly --nodeps --overwrite '*' --noconfirm --root /target $(cat /tmp/files.txt) >/tmp/db.log 2>&1 || { echo "dotfiles: parallel db failed"; tail -5 /tmp/db.log; poweroff -f; exit 1; }
fi
cp /mnt/seed/yudae-desktop.service /target/etc/systemd/system/ 2>/dev/null || true
cp /mnt/seed/yudaemond.service /target/etc/systemd/system/ 2>/dev/null || true
mkdir -p /target/proc /target/sys /target/dev
mount --bind /proc /target/proc
mount --bind /sys /target/sys
mount --bind /dev /target/dev
chroot /target /bin/bash -c '
systemd-sysusers 2>/dev/null || true
systemd-tmpfiles --create 2>/dev/null || true
ldconfig 2>/dev/null || true
id -u gabriel >/dev/null 2>&1 || useradd -m -u 1000 -G wheel,video,render,input -s /bin/bash gabriel
mkdir -p /etc/sudoers.d
printf "gabriel ALL=(ALL) NOPASSWD:ALL\n" > /etc/sudoers.d/gabriel
chmod 440 /etc/sudoers.d/gabriel
mkdir -p /home/gabriel/dotfiles /run/user/1000
chown gabriel:gabriel /run/user/1000
grep -q "dotfiles /home/gabriel/dotfiles virtiofs" /etc/fstab || echo "dotfiles /home/gabriel/dotfiles virtiofs ro,nofail,defaults 0 0" >> /etc/fstab
mkdir -p /home/gabriel/.config
ln -sfn /home/gabriel/dotfiles/hypr /home/gabriel/.config/hypr
passwd -d root >/dev/null 2>&1 || true
touch /var/lib/dotfiles-golden

'
cat > /target/usr/local/bin/dotfiles-firstboot.sh <<'FIX'
#!/bin/bash
[ -e /var/lib/dotfiles-fixups ] && exit 0
fc-cache -f 2>/dev/null || true
glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
update-desktop-database -q /usr/share/applications 2>/dev/null || true
update-ca-trust 2>/dev/null || true
depmod -a $(ls /usr/lib/modules | head -1) 2>/dev/null || true
touch /var/lib/dotfiles-fixups
FIX
chmod 755 /target/usr/local/bin/dotfiles-firstboot.sh
cat > /target/etc/systemd/system/dotfiles-firstboot.service <<'UNIT'
[Unit]
Description=dotfiles first boot fixups
ConditionPathExists=!/var/lib/dotfiles-fixups
After=local-fs.target
[Service]
