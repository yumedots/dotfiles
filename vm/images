UNIT
systemctl --root=/target enable yudaemond yudae-desktop dotfiles-firstboot.service >/dev/null 2>&1 || true
systemctl --root=/target set-default graphical.target >/dev/null 2>&1 || true
echo dotfiles-golden-ok > /dev/ttyS0
umount /target/proc /target/sys /target/dev 2>/dev/null || true
sync
umount /target 2>/dev/null || true
btrfs check --readonly /dev/vdc3 >/dev/null 2>&1 || { echo "dotfiles: parallel check failed"; poweroff -f; exit 1; }
