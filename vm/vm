#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)

case "${1:-}" in
	fetch|packages|golden|ensure|images|overlay)
		exec "$ROOT/vm/images" "$@"
		;;
	bench)
		exec "$ROOT/vm/bench.sh" "${@:2}"
		;;
	*)
		echo "usage: xmake vm fetch|packages|golden|ensure|bench (running VMs: yudae vm)" >&2
		exit 2
		;;
esac
