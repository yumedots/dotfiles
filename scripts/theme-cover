#!/usr/bin/env python3
import sys, tomllib, hashlib
from pathlib import Path
import numpy as np
from PIL import Image, ImageDraw, ImageFilter, ImageFont

W, H = 2560, 1440
FONT = "/usr/share/fonts/TTF/GoogleSansCodeNerdFont-Regular.ttf"


def hex_rgb(value, alpha=255):
    value = value.lstrip("#")
    if len(value) == 8:
        value = value[2:]
    return (int(value[0:2], 16), int(value[2:4], 16), int(value[4:6], 16), alpha)


def smooth_noise(rng, size, octaves=3):
    out = np.zeros(size, dtype=np.float64)
    weight = 1.0
    total = 0.0
    cells = 4
    for _ in range(octaves):
        grid = rng.random((max(2, cells * size[0] // size[1]), cells))
        layer = Image.fromarray((grid * 255).astype(np.uint8)).resize((size[1], size[0]), Image.BICUBIC)
        out += weight * (np.asarray(layer, dtype=np.float64) / 255.0)
        total += weight
        weight *= 0.45
        cells *= 2
    return out / total


def fallback(theme, palette, surface):
    seed = int.from_bytes(hashlib.sha256(theme.encode()).digest()[:8], "little")
    rng = np.random.default_rng(seed)
    low = (H // 4, W // 4)
    img = np.ones((low[0], low[1], 3)) * surface
    for color in palette[:3]:
        field = smooth_noise(rng, low)
        field = (field - field.min()) / max(1e-6, field.max() - field.min())
        light = np.clip((field - 0.3) / 0.7, 0, 1)[..., None] ** 2.2
        img = 1 - (1 - img) * (1 - light * color * 0.45)

    img = np.asarray(Image.fromarray((np.clip(img, 0, 1) * 255).astype(np.uint8)).resize((W, H), Image.BICUBIC),
                     dtype=np.float64) / 255.0
    grain = rng.normal(0, 0.004, (H, W, 1))
    return Image.fromarray((np.clip(img + grain, 0, 1) * 255).astype(np.uint8)).convert("RGB")


def crop(image):
    ratio = W / H
    width, height = image.size
    if width / height > ratio:
        width = round(height * ratio)
        image = image.crop(((image.size[0] - width) // 2, 0, (image.size[0] + width) // 2, height))
    else:
        height = round(width / ratio)
        image = image.crop((0, (image.size[1] - height) // 2, width, (image.size[1] + height) // 2))

    return image.convert("RGB").resize((W, H), Image.LANCZOS)


def bar(image, colors):
    surface = hex_rgb(colors.get("surface", "#101010"), 235)
    foreground = hex_rgb(colors.get("foreground", "#ffffff"))
    dim = hex_rgb(colors.get("dim", "#3f3f3f"))

    height = 52
    overlay = Image.new("RGBA", (W, height), surface)
    draw = ImageDraw.Draw(overlay)
    font = ImageFont.truetype(FONT, 22)
    marks = ImageFont.truetype(FONT, 20)

    x = 28
    for index, name in enumerate("1234"):
        ink = foreground if index == 0 else dim
        draw.text((x, 14), name, font=marks, fill=ink)
        x += 28

    clock = "Wed Nov 11 1:24 PM"
    width = draw.textlength(clock, font=font)
    draw.text(((W - width) / 2, 12), clock, font=font, fill=foreground)

    x = W - 32
    for key in ("red", "yellow", "memoryBase", "borderFallbackColor", "foreground"):
        color = hex_rgb(colors.get(key, colors.get("foreground", "#ffffff")))
        x -= 28
        draw.rounded_rectangle((x, 16, x + 18, 34), radius=4, fill=color)
        x -= 8

    draw.line((0, height - 1, W, height - 1), fill=hex_rgb(colors.get("dim", "#3f3f3f"), 90))

    image = image.convert("RGBA")
    image.alpha_composite(overlay, (0, 0))
    return image.convert("RGB")


def cover(theme_dir):
    data = tomllib.loads((theme_dir / "theme.toml").read_text())
    colors = data.get("colors", {})
    surface = hex_rgb(colors.get("surface", "#101010"))
    palette = [np.array(hex_rgb(v)[:3], dtype=np.float64) / 255.0
               for sec in data.values() if isinstance(sec, dict)
               for k, v in sec.items()
               if k in ("borderFallbackColor", "cpuBase", "memoryBase", "weatherBase", "yellow", "red") and isinstance(v, str)]

    wallpaper = theme_dir / "wallpaper.jpg"
    if not wallpaper.exists():
        wallpaper = theme_dir / "wallpaper.png"
    if wallpaper.exists():
        image = crop(Image.open(wallpaper))
    else:
        image = fallback(theme_dir.name, palette, np.array(surface[:3], dtype=np.float64) / 255.0)

    return bar(image, colors)


def main(argv):
    root = Path(__file__).resolve().parent.parent / "plugins"
    ids = argv[1:] or [p.name for p in sorted(root.iterdir()) if (p / "theme.toml").exists() and not p.name.startswith("_")]
    for name in ids:
        theme_dir = root / name
        if not (theme_dir / "theme.toml").exists():
            print(f"skip {name}: no theme.toml")
            continue
        target = theme_dir / "cover.jpg"
        cover(theme_dir).save(target, "JPEG", quality=92, subsampling=0)
        print(f"{target.relative_to(root.parent)} {target.stat().st_size // 1024}K")


if __name__ == "__main__":
    main(sys.argv)
