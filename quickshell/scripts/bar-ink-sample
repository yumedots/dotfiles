#!/usr/bin/env python3
# bar-ink-sample: print the mean brightness (0..1) of the bar strip on one
# output, so the bare bar can pick black or white ink. Prints -1 on any
# failure so the caller falls back to normal ink instead of a wrong one.
#
# Usage: bar-ink-sample <output-name> <bar-height-logical-px>

import json
import subprocess
import sys


def run(argv, stdin=None):
    return subprocess.run(argv, input=stdin, capture_output=True, timeout=15)


def main(screen, bar_h):
    monitors = run(["hyprctl", "monitors", "-j"])
    geo = None

    for monitor in json.loads(monitors.stdout or "[]"):
        if monitor.get("name") == screen:
            geo = "%d,%d %dx%d" % (
                monitor.get("x", 0), monitor.get("y", 0),
                monitor.get("width", 0), max(1, int(bar_h)))
            break

    if not geo:
        print(-1)
        return

    shot = run(["grim", "-g", geo, "-"])

    if not shot.stdout:
        print(-1)
        return

    mean = run(["magick", "png:-", "-colorspace", "Gray",
                "-format", "%[fx:mean]", "info:"], stdin=shot.stdout)
    text = mean.stdout.decode().strip()

    try:
        value = float(text)
    except ValueError:
        value = -1

    print(value if 0 <= value <= 1 else -1)


if __name__ == "__main__":
    main(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else 30)
