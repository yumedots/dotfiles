#!/bin/sh
set -eu

export HOME=/var/lib/greetd
export XDG_CACHE_HOME=/var/lib/greetd/cache
export XDG_STATE_HOME=/var/lib/greetd/state
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/greeter}"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland

if [ -n "${GREETD_SOCK:-}" ]; then
	waited=0
	while [ ! -S "$GREETD_SOCK" ] && [ "$waited" -lt 50 ]; do
		sleep 0.1
		waited=$((waited + 1))
	done
fi

exec /usr/bin/start-hyprland -- -c /etc/greetd/hyprland.lua
