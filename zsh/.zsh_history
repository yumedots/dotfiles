: 1788868539:0;# 1. fix the moved repo's git config\
sed -i '' 's|worktree = ../../../../src/engine|worktree = /Users/gabriel/felix|' /Users/gabriel/felix/.git/config\
sed -i '' 's|hooksPath = .githooks|hooksPath = /Users/gabriel/felix/.githooks|' /Users/gabriel/felix/.git/config\
 \
# 2. verify the engine repo\
git -C /Users/gabriel/felix status && git -C /Users/gabriel/felix log --oneline -3\
 \
# 3. de-submodule esp-1\
cd /Users/gabriel/esp-1\
git rm --cached src/engine\
rm .gitmodules\
git config --remove-section submodule.src/engine\
rmdir .git/modules/src/engine .git/modules 2>/dev/null\
 \
# 4. point esp-1 at the external engine\
sed -i '' 's|includes("src/engine/xmake.lua")|includes("../felix/xmake.lua")|' xmake.lua\
sed -i '' 's|$(projectdir)/src/engine|$(projectdir)/../felix|g' xmake.lua tests/xmake.lua\
 \
# 5. standalone engine (no -P needed anymore)\
cd /Users/gabriel/felix\
rm -rf .xmake .xmake.stale\
xmake f -m release -y\
xmake flx_cli\
xmake run flx_cli run tests/hotReloadPage.flx
